# ==============================================================================
# AI Security Lab v4.0 - Environment Configuration
# ==============================================================================
#
# This file contains all environment variables needed for deployment.
# Copy this file to .env and update the values before deployment.
#
# SECURITY WARNING: Never commit .env to version control!
#
# ==============================================================================

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================

# PostgreSQL/TimescaleDB password
# IMPORTANT: Change this in production!
POSTGRES_PASSWORD=secure-password-change-me

# Database connection details
DATABASE_HOST=timescaledb
DATABASE_PORT=5432
DATABASE_NAME=security_events
DATABASE_USER=security

# ==============================================================================
# REDIS CONFIGURATION
# ==============================================================================

# Redis password for caching and real-time data
# IMPORTANT: Change this in production!
REDIS_PASSWORD=redis-password-change-me

REDIS_HOST=redis-stack
REDIS_PORT=6379

# ==============================================================================
# OBJECT STORAGE (MinIO)
# ==============================================================================

# MinIO credentials for video/image storage
# IMPORTANT: Change these in production!
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minio-secure-password-change-me

MINIO_HOST=minio
MINIO_PORT=9000

# ==============================================================================
# FRIGATE PLUS (VIDEO DETECTION)
# ==============================================================================

# Frigate Plus API key (optional - for enhanced features)
# Get your key from: https://plus.frigate.video
PLUS_API_KEY=your-frigate-plus-api-key-here

# Frigate camera RTSP password
FRIGATE_CAM_PASS=camera-password-change-me

# ==============================================================================
# AI MODEL API KEYS (Optional)
# ==============================================================================

# DeepStack AI API key (optional)
DEEPSTACK_API_KEY=your-deepstack-api-key-here

# Plate Recognizer API key (optional - for enhanced plate recognition)
# Note: The system uses EasyOCR by default (no API key needed)
PLATE_RECOGNIZER_API_KEY=your-plate-recognizer-api-key-here

# ==============================================================================
# JWT AUTHENTICATION
# ==============================================================================

# JWT secret key for token signing
# CRITICAL: Must be at least 32 characters! Generate with: openssl rand -hex 32
JWT_SECRET_KEY=your-super-secure-jwt-secret-key-min-32-chars-change-me-now

# JWT token expiration (seconds)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ==============================================================================
# AI MODELS & GPU CONFIGURATION
# ==============================================================================

# Enable GPU acceleration for AI models
USE_GPU=true

# GPU device ID (if multiple GPUs available)
GPU_DEVICE_ID=0

# Model cache directory
MODEL_CACHE_DIR=/models

# YOLOv8 Model Configuration
# Options: yolov8n.pt (nano), yolov8s.pt (small), yolov8m.pt (medium)
YOLO_MODEL=yolov8n.pt

# Face Detection Model
# Options: mediapipe (fast), insightface (accurate)
FACE_DETECTOR_MODEL=mediapipe

# License Plate OCR Languages
# Comma-separated list: en,es,fr,de,etc
PLATE_OCR_LANGUAGES=en

# ==============================================================================
# THREAT DETECTION SETTINGS
# ==============================================================================

# Threat score threshold for alerts (0.0 - 1.0)
ALERT_THRESHOLD_SCORE=0.7

# Maximum concurrent threat analyses
MAX_CONCURRENT_ANALYSES=10

# Analysis timeout (seconds)
ANALYSIS_TIMEOUT_SECONDS=30

# Cache TTL for results (seconds)
CACHE_TTL_SECONDS=3600

# ==============================================================================
# ALERT & NOTIFICATION CONFIGURATION
# ==============================================================================

# Webhook URL for threat alerts (optional)
ALERT_WEBHOOK_URL=https://your-webhook-url.com/alerts

# Email notification settings (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=security@example.com
SMTP_TO=admin@example.com

# Slack webhook for notifications (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ==============================================================================
# MONITORING & OBSERVABILITY
# ==============================================================================

# Grafana admin password
# IMPORTANT: Change this in production!
GRAFANA_PASSWORD=admin-change-me

# Prometheus retention period
PROMETHEUS_RETENTION=15d

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Enable distributed tracing
ENABLE_TRACING=true

# Trace sampling rate (0.0 - 1.0)
TRACE_SAMPLING_RATE=0.1

# ==============================================================================
# FRONTEND CONFIGURATION
# ==============================================================================

# API base URL for frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# WebSocket URL
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Dashboard title
NEXT_PUBLIC_APP_TITLE=AI Security Lab v4.0

# ==============================================================================
# DEVELOPMENT SETTINGS (Optional)
# ==============================================================================

# Enable debug mode (development only!)
DEBUG=false

# Enable hot reload
HOT_RELOAD=true

# API rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ==============================================================================
# BACKUP CONFIGURATION
# ==============================================================================

# Backup directory
BACKUP_DIR=/backups

# Backup retention days
BACKUP_RETENTION_DAYS=30

# Automatic backup schedule (cron format)
BACKUP_SCHEDULE=0 2 * * *

# ==============================================================================
# PERFORMANCE TUNING
# ==============================================================================

# Database connection pool size
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20

# Worker processes
WORKER_PROCESSES=4

# Max request size (MB)
MAX_REQUEST_SIZE=100

# ==============================================================================
# SECURITY SETTINGS
# ==============================================================================

# Enable HTTPS (production)
ENABLE_HTTPS=false

# SSL certificate paths (if HTTPS enabled)
SSL_CERT_PATH=/certs/fullchain.pem
SSL_KEY_PATH=/certs/privkey.pem

# Session timeout (minutes)
SESSION_TIMEOUT=60

# Maximum login attempts
MAX_LOGIN_ATTEMPTS=5

# Account lockout duration (minutes)
LOCKOUT_DURATION=30

# ==============================================================================
# END OF CONFIGURATION
# ==============================================================================

# Deployment checklist:
# [ ] Change all passwords and secrets
# [ ] Generate new JWT_SECRET_KEY (min 32 chars)
# [ ] Configure database credentials
# [ ] Set up alert webhooks
# [ ] Configure GPU settings
# [ ] Enable HTTPS in production
# [ ] Review security settings
# [ ] Test all services after configuration
