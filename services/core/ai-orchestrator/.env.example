# ============================================================================
# AI Security Lab v4.0 - AI Orchestrator Configuration
# ============================================================================

# Application
ENVIRONMENT=development
DEBUG=false

# Database (TimescaleDB)
DATABASE_HOST=timescaledb
DATABASE_PORT=5432
DATABASE_NAME=security_events
DATABASE_USER=security
DATABASE_PASSWORD=changeme_secure_password
DATABASE_MIN_POOL_SIZE=5
DATABASE_MAX_POOL_SIZE=20

# Redis Cache
REDIS_HOST=redis-stack
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50

# Frigate NVR
FRIGATE_URL=http://frigate-plus:5000
FRIGATE_API_KEY=
FRIGATE_TIMEOUT=10

# Threat Detector Service
THREAT_DETECTOR_URL=http://threat-detector:8001
THREAT_DETECTOR_ENABLED=true
THREAT_DETECTOR_TIMEOUT=30

# AI Orchestrator Performance
MAX_CONCURRENT_ANALYSES=10
DETECTION_QUEUE_SIZE=1000
RESULT_QUEUE_SIZE=1000
WORKER_COUNT=5

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_RELOAD=true
CORS_ORIGINS=*

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_TO_FILE=false
LOG_FILE_PATH=logs/orchestrator.log

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
ENABLE_TRACING=false
JAEGER_HOST=tempo
JAEGER_PORT=6831

# Storage (MinIO)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=security-footage

# Feature Flags
ENABLE_WEBSOCKET=true
ENABLE_BATCH_PROCESSING=true
ENABLE_AUTO_RESPONSE=false

# GPU Configuration
GPU_ENABLED=true
GPU_DEVICE_ID=0
BATCH_SIZE=8
INFERENCE_TIMEOUT=30
